# Public canonical origin (HTTPS, www)
NEXT_PUBLIC_SITE_URL=https://www.traveldeskgenie.com

# Leave empty: translation runs through `npm run i18n:auto` (QA-aware), not during `next build`
TRANSLATION_PROVIDER=

# Azure Translator (server/build machine only — never prefix with NEXT_PUBLIC_)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# LibreTranslate fallback
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Index machine translations that pass automated QA (true by default). Set false for human-review-only indexing.
I18N_INDEX_MACHINE=true
# Minimum share of translated messages before a locale is used for automatic negotiation
I18N_AVAILABLE_MIN=0.9

# Region detection: automatic on Vercel. Set to cloudflare or cloudfront only if the origin is locked to that edge.
GEO_PROVIDER=