
# Travel Desk Genie — Environment Configuration

# Public canonical origin (HTTPS, www)
NEXT_PUBLIC_SITE_URL=https://www.traveldeskgenie.com

# Vercel country detection is enabled automatically.
# Set to "cloudflare" or "cloudfront" only when that edge
# overwrites its country header.
GEO_PROVIDER=

# Supabase PostgreSQL — GDS Search Engine
# Set actual values in .env.local for local development.
# Configure production values in Vercel only after testing.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SERVER ONLY — never prefix with NEXT_PUBLIC_
# Never commit an actual Supabase secret key.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
