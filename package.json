{
  "name": "travel-genie-website",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/preview.mjs",
    "prebuild": "node scripts/i18n-prepare.mjs && node scripts/i18n-auto.mjs --status-only",
    "build": "next build",
    "start": "next start",
    "check": "node scripts/release-check.mjs && npm run check:seo",
    "check:genie": "node scripts/check-genie.mjs",
    "check:rendered": "node scripts/verify-rendered.mjs",
    "release": "npm run check && npm run test:i18n && npm run check:genie && npm run build && npm run check:rendered && npm run i18n:release",
    "test:i18n": "node --test tests/i18n.test.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:translate": "node scripts/i18n.mjs translate all",
    "i18n:report": "node scripts/i18n.mjs report",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:release": "node scripts/i18n.mjs release",
    "i18n:auto": "node scripts/i18n-auto.mjs all",
    "i18n:auto:tier1": "node scripts/i18n-auto.mjs all --tier=1",
    "i18n:status": "node scripts/i18n-auto.mjs --status-only",
    "check:seo": "node scripts/check-seo.mjs && node scripts/check-resource-routes.mjs"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "description": "Travel Genie website with catalog-based localization for 24 target locales",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
