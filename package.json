{
  "name": "travel-genie-website",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/preview.mjs",
    "prebuild": "node scripts/i18n-extract.mjs",
    "build": "next build",
    "start": "next start",
    "check": "node scripts/release-check.mjs && npm run check:seo",
    "check:genie": "node scripts/check-genie.mjs",
    "check:rendered": "node scripts/verify-rendered.mjs",
    "release": "npm run check && npm run test:i18n && npm run check:genie && npm run build && npm run check:rendered",
    "test:i18n": "node --test tests/i18n.test.mjs tests/i18n-migration.test.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "check:seo": "node scripts/check-seo.mjs && node scripts/check-resource-routes.mjs",
    "audit:i18n": "node scripts/audit-locales.mjs",
    "migrate:i18n": "node scripts/migrate-legacy-translations.mjs"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "description": "Travel Genie website with nine configured locale routes and static, review-gated dictionaries",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
